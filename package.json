    "api": "node server/index.js",
    "full": "concurrently \"npm run dev\" \"npm run api\""
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "jszip": "^3.10.1",
    "proj4": "^2.21.0",
    "react": "^19.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.0",
    "satellite.js": "^6.0.2",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^10.0.4",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.10"
  }
}
