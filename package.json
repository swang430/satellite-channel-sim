{
  "name": "sim-satellite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:physics": "node test.mjs && node test_channel_sim.mjs && node test_accuracy_report.mjs",
    "test:watch": "vitest",
    "verify": "npm run test && npm run test:physics && npm run lint && npm run build",
